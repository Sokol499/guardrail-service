# Application
APP_NAME=guardrail-service
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI (required for cloud moderation)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Local moderation
LOCAL_MODEL_NAME=unitary/toxic-bert
LOCAL_MODEL_THRESHOLD=0.65

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
POLICY_DATA_PATH=./data/policies/policy_chunks.json
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_JAILBREAK_THRESHOLD=0.62

# Moderation defaults
DEFAULT_APPROACH=local
RAG_TOP_K=5
